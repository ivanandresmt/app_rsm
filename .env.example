# Copy to .env. Everything here is a DEMO value; change secrets outside local use.
POSTGRES_USER=rsm
POSTGRES_PASSWORD=rsm
POSTGRES_DB=rsm

JWT_SECRET=change-me-change-me-change-me-32b
DEV_LOGIN_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# provider (the mock in compose). The app only uses the public contract.
PROVIDER_TOKEN=travel-demo-token
CONTROL_TOKEN=control-demo-token
QUOTE_TTL_SECONDS=900

# assistant (optional: everything else works without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# demo knob: make PDF generation visibly slow (seconds)
PDF_RENDER_DELAY_S=0

NEXT_PUBLIC_API_URL=http://localhost:8000

# host port for the frontend (change if 3000 is taken; also add it to CORS_ORIGINS)
FRONTEND_PORT=3000
